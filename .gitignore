# ============================================================
# 神智核 / F6 筆記整合網 · Git 忽略規則
#
# 重要：本檔位於 f6chem/ 內，所有路徑都相對 f6chem/ 書寫，
#       不可寫成 f6chem/site/...（那會完全失效）。
#
# 原則：只追蹤「原始碼與資料」，不追蹤「建置產物」與「測試暫存」。
#   資料    ：data/、quiz/、extras/
#   原始碼  ：site/*.py|*.js|*.json|template.html、*.py
#   產物    ：神智核*.html、gh-pages/、部署包（皆可由原始碼重建）
# ============================================================

# ---------- 建置產物 ----------
site/神智核.html
site/神智核-V*.html
site/F6筆記整合網.html
site/F6化學筆記整合網.html
site/index.html
gh-pages/
# 註：部署包（神智核-GitHub部署包/ 與 .zip）位於 f6chem/ 之外，
#     不在本倉庫範圍內，無需在此忽略。

# ---------- 測試暫存 ----------
# 測試用單檔 HTML（每次 build 重生，5–9 MB）
site/_t_*.html
site/_appcheck.js
site/_check_main.js
# headless Chrome 臨時 profile（每個約 10 MB，累積上百 MB）
site/_t_profile*/
# 一次性除錯腳本（`_` 前綴慣例；正式腳本在 scripts/ 與 site/build.py）
site/_*.py
site/_*.cjs
site/_*.png
site/_screenshot_check/
# 舊版本建置產物快照（14 MB，可由 git 歷史取回）
site/archive/
# OCR 逐頁辨識出的中間文字（330 KB，屬可重生中間物）
e3_src/
# Python 快取
__pycache__/
*.pyc

# ---------- 截圖（人工檢視用）----------
site/shots/
shots/
scratch/phys_preview/
scratch/phys_extract/
scratch/phys_bundles/
# 力學的提取中間產物（mech_extract/ 是 PDF 文字提取，mech_pagemap 是頁面映射）
scratch/mech_extract/
scratch/mech_pagemap.txt
# 波動學的提取中間產物（同上）
scratch/waves_extract/
scratch/waves_pagemap.txt

# ---------- 原始 PDF 頁圖（97 MB；data/ 已記錄 page，site/img/ 才是內嵌用）----------
pages/

# ---------- OCR 中間產物 ----------
ocr/
notes-raw/
# 逐頁 OCR 純文字轉儲（可重生，不進倉庫）
scratch/pp_*_p1.txt
scratch/ocr_*.txt
scratch/sub_hits.txt
scratch/*_raw.txt
scratch/*_uniq.txt
scratch/dse_bio_mc.txt
scratch/dse_bio_mc_byyear.json
scratch/dse_bio_mc_items.json
scratch/img_*.txt
scratch/bio_probe/
scratch/elect_probe/
scratch/backups/
# 一次性除錯腳本（`_` 前綴慣例，與 site/_*.py 同理）
scratch/_*.py
scratch/e3_pagemap.txt

# ---------- scratch 的中間產物（保留生產管線 .py 腳本與其說明）----------
# backup_*：舊資料快照（內容已在 data/ 正式版，屬重複）
scratch/backup_data_premerge/
scratch/backup_exam/
scratch/backup_dedup/
# 逐頁處理的中間檔
scratch/pp/
scratch/map/
scratch/prompts/
scratch/prompts2/
scratch/genui-src/
scratch/figcrops/
scratch/sheets/
scratch/__pycache__/

# ---------- 作業系統 / 編輯器 ----------
Thumbs.db
desktop.ini
.DS_Store
*.swp
*.tmp
~$*

# ---------- 依賴與快取 ----------
# node_modules 不提交（体积大、可由 package.json 重装）；
# 但 package.json 與 package-lock.json 要提交，才能鎖定版本、重現環境。
node_modules/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---------- 內嵌 Python 執行環境（可重建，勿入庫）----------
# 這些是本機打包用的可攜式 Python，數千個檔案、數十 MB，與原始碼無關
Python/
site/Python/

# ---------- 備份檔 ----------
*.bak-*
*.bak-????????-????

# ---------- 建置產物與部署目錄（可由原始碼重建）----------
site/gh-pages/
site/神智核-V*.html

# 原卷 OCR 中间产物（页图 + OCR JSON，约 150MB）
scratch/_pp_pages/
scratch/_pp_ocr/
scratch/_pp_build.log

# 题解扩写中间产物（纯文本题解稿）
scratch/_ex_*.txt

# 本輪排查的臨時腳本與截圖
scratch/_md_*.js
scratch/_shot_*.js
scratch/_browser_check.js
scratch/shot_*.png
scratch/_bak_pp_v024.json
